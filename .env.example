# Copy this file to .env and fill in the real values locally.
# Never commit .env — it is now listed in .gitignore.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# DENNIS integration key for the dennis-read Edge Function.
# This is NOT a project .env value — it must be set as a Supabase Edge
# Function secret instead:
#   supabase secrets set DENNIS_INTEGRATION_KEY=<value>
# Listed here only for documentation/discoverability.
